{
  "name": "glowtide",
  "version": "1.0.17",
  "description": "A music companion for Windows: album-coloured edge glow and word-by-word lyrics for any music app, YouTube Music or Spotify",
  "main": "./out/main/index.js",
  "author": "cynicalk",
  "license": "MIT",
  "homepage": "https://github.com/cynicalk/glowtide",
  "repository": {
    "type": "git",
    "url": "https://github.com/cynicalk/glowtide.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run lint && npm test && npm run build && electron-builder --win",
    "test": "node --test \"test/*.test.mjs\"",
    "build:icon": "electron scripts/build-icon.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^3.0.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.11.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "lucide-react": "^0.468.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4"
  },
  "productName": "Glowtide",
  "private": true
}
